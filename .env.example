# Copy this file to .env for local development: `cp .env.example .env`

# ── Public site database (Turso / libsql) ────────────────────────────────────
# Used by the existing RSVP features and read-only by GET /api/internal/guests.
TURSO_DATABASE_URL=
# Required when TURSO_DATABASE_URL points to a remote Turso database.
TURSO_AUTH_TOKEN=

# The internal seating planner (/internal/seating, /api/internal/*) needs no
# environment variable: it is gated by a hardcoded password (see README).
