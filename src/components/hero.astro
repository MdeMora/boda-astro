---

---

<section
  class="relative z-0 h-screen overflow-hidden w-full flex flex-col items-center justify-center text-center px-4"
>
  <img
    src="/fondo1.jpg"
    alt=""
    aria-hidden="true"
    class="w-full h-full object-cover absolute top-0 left-0 opacity-20"
  />
  <div class="z-10 animate-fade-in-up space-y-6">
    <p
      class="text-wedding-olive tracking-[0.3em] uppercase text-sm md:text-base font-sans"
    >
      ¡Nos casamos!
    </p>
    <h1
      class="text-5xl md:text-7xl lg:text-8xl font-serif text-wedding-charcoal leading-tight"
    >
      <span class="block md:inline">Cristina</span>
      <span
        class="block md:inline text-wedding-olive italic md:mx-2 leading-none"
        >&</span
      >
      <span class="block md:inline">Miguel</span>
    </h1>
    <div class="w-24 h-[1px] bg-wedding-olive/30 mx-auto my-8"></div>
    <p
      class="text-xl md:text-2xl font-serif text-wedding-charcoal/80 tracking-wide"
    >
      2 de Octubre, 2026
    </p>
  </div>

  <a
    href="#detalles"
    aria-label="Ver detalles de la boda"
    class="absolute bottom-10 z-10 animate-bounce rounded-full p-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-wedding-olive/40"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-8 h-8 text-wedding-olive/50"><path d="m6 9 6 6 6-6"></path></svg
    >
  </a>

  <img
    src="/boda-flores.webp"
    alt=""
    aria-hidden="true"
    class="pointer-events-none select-none absolute left-1/2 -translate-x-1/2 -bottom-36 w-[320px] max-w-[90vw] -rotate-90 scale-[0.75] md:left-auto md:translate-x-0 md:-right-4 md:bottom-[55px] md:w-[360px] md:max-w-none md:rotate-0 md:scale-100 md:-scale-x-100 lg:right-2 lg:bottom-[-120px] lg:w-[460px]"
  />
  <img
    src="/boda-flores.webp"
    alt=""
    aria-hidden="true"
    class="pointer-events-none select-none absolute left-1/2 -translate-x-1/2 -top-36 w-[320px] max-w-[90vw] rotate-90 scale-[0.75] md:-left-4 md:translate-x-0 md:right-auto md:top-auto md:bottom-[55px] md:w-[360px] md:max-w-none md:rotate-0 md:scale-100 lg:left-2 lg:bottom-[-120px] lg:w-[460px]"
  />
</section>
