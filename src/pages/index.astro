---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/hero.astro";
import EventDetails from "@/components/EventDetails.astro";
import Organization from "@/components/Organization.astro";
import Photos from "@/components/Photos.astro";
import Faq from "@/components/Faq.astro";
import Footer from "@/components/Footer.astro";
import Gifts from "@/components/Gifts.astro";
import Rsvp from "@/components/Rsvp";
---

<Layout>
  <main class="min-h-screen font-sans">
    <Hero />
    <EventDetails />
    <Rsvp client:load />
    <Organization />
    <Gifts />
    <Photos />
    <Faq />
    <Footer />
  </main>
</Layout>
